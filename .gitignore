# ==============================================================================
# FOLDER & ARCHITECTURE GUIDE (LetMeCook - MERN Stack)
# ==============================================================================
#
# /
# ├── Guide/               # Project documentation, guides, and master references
# ├── server/              # Backend (Node.js, Express, MongoDB/Mongoose)
# │   ├── node_modules/    # Backend installed packages (Ignored)
# │   ├── .env             # Backend secrets and environment configs (Ignored)
# │   └── package.json     # Backend dependencies & scripts
# └── client/              # Frontend (React + Vite, Axios, Lucide Icons)
#     ├── node_modules/    # Frontend installed packages (Ignored)
#     ├── dist/            # Production build bundle (Ignored)
#     ├── .env.local       # Frontend local environment configs (Ignored)
#     └── package.json     # Frontend dependencies & scripts
#
# ==============================================================================
# GITIGNORE RULES
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
server/node_modules/
client/node_modules/
.pnp
.pnp.js

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# Build and production outputs
dist/
build/
client/dist/
server/dist/
out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Temporary files & cache
.cache/
.eslintcache
.parcel-cache
